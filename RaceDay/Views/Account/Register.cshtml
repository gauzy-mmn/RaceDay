@model RaceDay.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}
<div class="rd2-auth rd2-auth-register">
    <section class="rd2-auth-form-side">
        <div class="rd2-auth-inner">
            <span class="rd2-kicker">RACEDAY / THE STARTING LINE</span>
            <h1 class="rd2-title">Your race <em>starts here.</em></h1>
            <p class="rd2-lead mb-4">Create your account to discover events or organise your next race.</p>
            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                    <div class="col-sm-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                </div>
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Role" class="form-label">Account type</label><select asp-for="Role" class="form-select"><option value="">Select account type</option><option value="Participant">Participant</option><option value="Organiser">Organiser</option></select><span asp-validation-for="Role" class="text-danger"></span></div>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
                    <div class="col-sm-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                </div>
                <button type="submit" class="rd2-pill">Create account <span aria-hidden="true">↗</span></button>
            </form>
            <p class="rd2-auth-note">Already a member? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
        </div>
    </section>
    <aside class="rd2-auth-visual" aria-label="Running photography">
        <img src="~/images/auth-runner.jpg" asp-append-version="true" alt="Athlete getting ready to run" onerror="this.style.display='none'" />
        <div class="rd2-auth-visual-text"><span class="rd2-kicker" style="color:#d1e0f4">NEW JOURNEYS</span><h2>Make it your race.</h2><p>There is a starting line for everyone. Find yours.</p></div>
    </aside>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
