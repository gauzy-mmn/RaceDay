@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model List<RaceDay.Models.RaceResultViewModel>

@{
    ViewData["Title"] = "My Race Results";

    int totalRaces = Model.Count;

    int? bestPosition = Model.Any()
        ? Model.Min(r => r.FinishPosition)
        : null;
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="fw-bold">My Race Results</h1>

        <p class="text-muted">
            Track your race performances,
            finishing times and positions.
        </p>
    </div>

    <!-- Error Message -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <h4 class="fw-bold">
                No Race Results Yet
            </h4>

            <p class="text-muted">
                Your race results will appear here
                once they have been recorded
                by the event Organiser.
            </p>

            <a asp-controller="Participant"
               asp-action="MyEnrolments"
               class="btn btn-primary mt-3">
                View My Enrolments
            </a>
        </div>
    }
    else
    {
        <!-- Results Summary -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted">
                            Races With Results
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @totalRaces
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted">
                            Best Finishing Position
                        </h6>

                        <h2 class="fw-bold mb-0">
                            @bestPosition
                        </h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Race Results Table -->
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th scope="col">Race Event</th>
                        <th scope="col">Category</th>
                        <th scope="col">Finish Time</th>
                        <th scope="col">Position</th>
                        <th scope="col">Recorded Date</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @result.EventName
                                </strong>
                            </td>

                            <td>
                                @result.CategoryName
                            </td>

                            <td>
                                @result.FinishTime
                            </td>

                            <td>
                                @result.FinishPosition
                            </td>

                            <td>
                                @(result.CapturedAt.ToString("dd MMM yyyy"))
                            </td>

                            <td>
                                <a asp-controller="Participant"
                                   asp-action="EventDetails"
                                   asp-route-id="@result.EventId"
                                   class="btn btn-sm btn-outline-primary">
                                    View Event
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <a asp-controller="Participant"
           asp-action="MyEnrolments"
           class="btn btn-outline-secondary mt-3">
            My Enrolments
        </a>
    }

</div>

