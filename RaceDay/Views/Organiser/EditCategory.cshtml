@model RaceDay.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <h1 class="fw-bold mb-2">
                Edit Category
            </h1>

            <p class="text-muted mb-4">
                Update the category for @ViewBag.EventName
            </p>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-controller="Organiser"
                          asp-action="EditCategory"
                          asp-route-eventId="@Model.EventId"
                          asp-route-categoryId="@Model.CategoryId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="EventId" />

                        <input type="hidden"
                               asp-for="CategoryId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Category Name -->
                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="Organiser"
                               asp-action="Categories"
                               asp-route-eventId="@Model.EventId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

