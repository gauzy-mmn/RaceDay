@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Organiser Dashboard</h1>
        <p class="text-muted">
            Welcome to RaceDay. Manage your races,
            participants and results from one place.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Manage Events</h5>
                    <p class="text-muted">
                        Create, update and manage
                        your race events.
                    </p>
                    <span class="badge bg-secondary">
                        Coming next
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Participants</h5>
                    <p class="text-muted">
                        View event registrations
                        and participant enrolments.
                    </p>
                    <span class="badge bg-secondary">
                        Coming next
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Race Results</h5>
                    <p class="text-muted">
                        Record finish times and
                        manage race results.
                    </p>
                    <span class="badge bg-secondary">
                        Coming next
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>

