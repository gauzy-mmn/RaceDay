@model List<RaceDay.Models.EventViewModel>
@{
    ViewData["Title"] = "Manage Events";
}
<section class="rd2-page">
    <div class="rd2-shell">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
        }
        <div class="rd2-page-head rd2-observe">
            <div><span class="rd2-kicker">ORGANISER / WORKSPACE</span><h1>Manage <span style="color:#8a9cb1">events.</span></h1><p>Every detail matters. Manage your races, categories, results and banners from one place.</p></div>
            <a class="rd2-pill" asp-controller="Organiser" asp-action="CreateEvent">Create event ↗</a>
        </div>
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info" role="status">You haven't created an event yet. Select Create event to begin.</div>
        }
        else
        {
            <div class="table-responsive rd2-observe">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Type</th><th>Banner</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var raceEvent in Model)
                        {
                            <tr>
                                <td class="rd2-organiser-event-name">@raceEvent.Name</td>
                                <td style="white-space:nowrap">@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@raceEvent.Location</td>
                                <td style="white-space:nowrap">@raceEvent.Distance km</td>
                                <td><span class="badge bg-secondary">@raceEvent.EventType</span></td>
                                <td>
                                    <div class="rd2-banner-thumb">
                                        <img src="@Url.Action("Banner", "Events", new { id = raceEvent.EventId })" alt="Banner for @raceEvent.Name" onerror="this.style.display='none'" />
                                        <span aria-hidden="true">NO BANNER</span>
                                    </div>
                                    <form class="rd2-banner-form" asp-controller="Organiser" asp-action="UploadEventBanner" asp-route-eventId="@raceEvent.EventId" method="post" enctype="multipart/form-data">
                                        @Html.AntiForgeryToken()
                                        <label for="banner-@raceEvent.EventId" class="visually-hidden">Upload banner for @raceEvent.Name</label>
                                        <input id="banner-@raceEvent.EventId" type="file" name="file" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />
                                        <button type="submit" class="btn btn-sm btn-primary w-100">Upload banner</button>
                                        <div class="form-text">JPG, PNG, WebP · 5 MB max</div>
                                    </form>
                                </td>
                                <td>
                                    <div class="rd2-actions">
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@raceEvent.EventId">Enrolments</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Organiser" asp-action="Results" asp-route-eventId="@raceEvent.EventId">Results</a>
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@raceEvent.EventId">Edit</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Organiser" asp-action="Categories" asp-route-eventId="@raceEvent.EventId">Categories</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-controller="Organiser" asp-action="DeleteEvent" asp-route-id="@raceEvent.EventId">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <a asp-controller="Organiser" asp-action="Index" class="btn btn-outline-secondary mt-4">Back to dashboard</a>
    </div>
</section>
