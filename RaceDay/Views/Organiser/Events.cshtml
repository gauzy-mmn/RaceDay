@model List<RaceDay.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-5">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Page Heading -->
    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Manage Events</h1>

            <p class="text-muted">
                View and manage your race events.
            </p>

            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="btn btn-primary mb-3">
                + Create New Event
            </a>
        </div>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped
                table-hover align-middle">

                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Banner</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var raceEvent in Model)
                    {
                        <tr>

                            <!-- Event Name -->
                            <td>
                                @raceEvent.Name
                            </td>

                            <!-- Event Date -->
                            <td>
                                @raceEvent.EventDate.ToString(
                                    "dd MMM yyyy")
                            </td>

                            <!-- Location -->
                            <td>
                                @raceEvent.Location
                            </td>

                            <!-- Distance -->
                            <td>
                                @raceEvent.Distance km
                            </td>

                            <!-- Event Type -->
                            <td>
                                @raceEvent.EventType
                            </td>

                            <!-- Event Banner -->
                            <td style="min-width: 220px;">

                                <div class="rounded-3
                                    overflow-hidden mb-2"
                                     style="height: 100px;
                                    background: #eef0f3;">

                                    <img src="@Url.Action("Banner", "Events", new { id = raceEvent.EventId })"
                                         alt="Banner for @raceEvent.Name"
                                         class="w-100 h-100"
                                         style="object-fit: cover;"
                                         onerror="this.style.display='none';
                                    this.nextElementSibling.style.display='flex';" />

                                    <!-- Fallback -->
                                    <div class="w-100 h-100
                                        align-items-center
                                        justify-content-center"
                                         style="display: none;
                                        background: #eef0f3;">

                                        <span class="text-muted small">
                                            No banner uploaded
                                        </span>

                                    </div>
                                </div>

                                <!-- Upload Banner Form -->
                                <form asp-controller="Organiser"
                                      asp-action="UploadEventBanner"
                                      asp-route-eventId="@raceEvent.EventId"
                                      method="post"
                                      enctype="multipart/form-data">

                                    @Html.AntiForgeryToken()

                                    <input type="file"
                                           id="banner-@raceEvent.EventId"
                                           name="file"
                                           class="form-control
                                    form-control-sm mb-2"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           aria-label="Banner for @raceEvent.Name"
                                           required />

                                    <button type="submit"
                                            class="btn btn-sm
                                        btn-primary w-100">
                                        Upload Banner
                                    </button>

                                    <div class="form-text">
                                        JPG, PNG or WebP. Max 5 MB.
                                    </div>

                                </form>

                            </td>

                            <!-- Event Management Actions -->
                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-controller="Organiser"
                                       asp-action="Enrolments"
                                       asp-route-eventId="@raceEvent.EventId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Enrolments
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="Results"
                                       asp-route-eventId="@raceEvent.EventId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Results
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@raceEvent.EventId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="Categories"
                                       asp-route-eventId="@raceEvent.EventId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Categories
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="DeleteEvent"
                                       asp-route-id="@raceEvent.EventId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>
    }

    <!-- Back to Dashboard -->
    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Back to Dashboard
    </a>

</div>
