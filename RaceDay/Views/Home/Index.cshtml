@{
    ViewData["Title"] = "The Starting Line";

    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    bool isOrganiser = User.IsInRole("Organiser");

    string destinationController = !isLoggedIn
        ? "Account"
        : isOrganiser ? "Organiser" : "Participant";

    string destinationAction = !isLoggedIn
        ? "Register"
        : "Events";

    string primaryLabel = !isLoggedIn
        ? "Get Started"
        : isOrganiser ? "Manage Events" : "Explore Events";
}

<div class="rdx-home">

    <!-- CINEMATIC HERO -->
    <section class="rdx-hero">

        <img class="rdx-hero-image"
             src="~/images/raceday-hero.webp"
             asp-append-version="true"
             alt="Runners taking part in a South African road race"
             fetchpriority="high" />

        <div class="rdx-shell rdx-hero-inner">

            <div class="rdx-hero-content">

                <div class="rdx-eyebrow rdx-hero-eyebrow">
                    <span class="rdx-live-dot"></span>
                    RACEDAY / THE STARTING LINE
                </div>

                <h1 class="rdx-hero-title">
                    Every race.
                    <span>Every moment.</span>
                </h1>

                <p class="rdx-hero-description">
                    The starting line is just the beginning.
                    Discover new challenges, push your limits
                    and make every finish count.
                </p>

                <div class="rdx-hero-actions">

                    <a asp-controller="@destinationController"
                       asp-action="@destinationAction"
                       class="rdx-primary-button">

                        @primaryLabel
                        <span aria-hidden="true">↗</span>
                    </a>

                    <a href="#rdx-experience"
                       class="rdx-hero-secondary">
                        Explore the experience
                        <span aria-hidden="true">↓</span>
                    </a>

                </div>

            </div>

            <div class="rdx-hero-bottom">

                <div class="rdx-hero-index">
                    <span class="rdx-index-line"></span>
                    001 / THE JOURNEY BEGINS
                </div>

                <div class="rdx-hero-categories">
                    RUN <span>•</span> WALK <span>•</span> CYCLE
                </div>

            </div>

        </div>

        <div class="rdx-hero-outline"
             aria-hidden="true">
            RD.
        </div>

    </section>

    <!-- RACE STRIP -->
    <div class="rdx-race-strip">

        <div class="rdx-shell rdx-strip-inner">
            <span>FIND YOUR RACE</span>
            <span class="rdx-strip-symbol">✳</span>
            <span>OWN YOUR PACE</span>
            <span class="rdx-strip-symbol">✳</span>
            <span>CROSS THE LINE</span>
        </div>

    </div>

    <!-- EDITORIAL INTRODUCTION -->
    <section class="rdx-intro"
             id="rdx-experience">

        <div class="rdx-shell">

            <div class="rdx-intro-grid">

                <div>
                    <span class="rdx-section-eyebrow">
                        01 / THE RACEDAY EXPERIENCE
                    </span>

                    <h2 class="rdx-section-heading">
                        More than
                        <span>a finish line.</span>
                    </h2>
                </div>

                <div class="rdx-intro-copy">

                    <p>
                        A great race is more than a distance.
                        It's the anticipation, the challenge,
                        the people and the feeling of crossing
                        that finish line.
                    </p>

                    <p>
                        RaceDay brings event discovery,
                        registration and results together
                        in one connected experience.
                    </p>

                    <div class="rdx-intro-detail">
                        <span class="rdx-intro-detail-line"></span>
                        BUILT FOR EVERY START
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- IMAGE-LED FEATURE SECTION -->
    <section class="rdx-journey">

        <div class="rdx-shell">

            <div class="rdx-journey-heading">

                <div>
                    <span class="rdx-section-eyebrow">
                        02 / THE JOURNEY
                    </span>

                    <h2 class="rdx-section-heading">
                        Find your pace.
                        <span>Make your mark.</span>
                    </h2>
                </div>

                <p>
                    From discovering the right event
                    to celebrating your achievement,
                    every step matters.
                </p>

            </div>

            <div class="rdx-feature-grid">

                <!-- FEATURE ONE -->
                <article class="rdx-feature rdx-feature-discover">

                    <img src="~/images/feature-discover.webp"
                         asp-append-version="true"
                         alt="Runners setting off on a race route"
                         loading="lazy" />

                    <div class="rdx-feature-shade"></div>

                    <div class="rdx-feature-top">
                        <span>01 / DISCOVER</span>
                        <span aria-hidden="true">↗</span>
                    </div>

                    <div class="rdx-feature-content">
                        <span class="rdx-feature-kicker">
                            YOUR NEXT CHALLENGE
                        </span>

                        <h3>
                            Find the race
                            that moves you.
                        </h3>

                        <p>
                            Explore events, discover new
                            places and choose your next
                            challenge.
                        </p>
                    </div>

                </article>

                <!-- FEATURE TWO -->
                <article class="rdx-feature rdx-feature-participate">

                    <img src="~/images/feature-participate.webp"
                         asp-append-version="true"
                         alt="Athletes running through a scenic landscape"
                         loading="lazy" />

                    <div class="rdx-feature-shade"></div>

                    <div class="rdx-feature-top">
                        <span>02 / PARTICIPATE</span>
                        <span aria-hidden="true">↗</span>
                    </div>

                    <div class="rdx-feature-content">
                        <span class="rdx-feature-kicker">
                            THE STARTING LINE
                        </span>

                        <h3>
                            Show up.
                            Go further.
                        </h3>

                        <p>
                            Register for your event
                            and experience every
                            moment of race day.
                        </p>
                    </div>

                </article>

                <!-- FEATURE THREE -->
                <article class="rdx-feature rdx-feature-achieve">

                    <img src="~/images/feature-achieve.webp"
                         asp-append-version="true"
                         alt="An athlete celebrating at a race finish line"
                         loading="lazy" />

                    <div class="rdx-feature-shade"></div>

                    <div class="rdx-feature-top">
                        <span>03 / ACHIEVE</span>
                        <span aria-hidden="true">✓</span>
                    </div>

                    <div class="rdx-feature-content">

                        <span class="rdx-feature-kicker">
                            THE FINISH LINE
                        </span>

                        <h3>
                            Every finish
                            tells a story.
                        </h3>

                        <p>
                            Track your results and
                            celebrate the progress
                            you've earned.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- EDITORIAL STATEMENT -->
    <section class="rdx-statement">

        <div class="rdx-shell rdx-statement-inner">

            <span class="rdx-section-eyebrow">
                03 / BEYOND THE FINISH
            </span>

            <h2>
                It's not about
                <span>being first.</span>
                It's about
                <span>moving forward.</span>
            </h2>

            <div class="rdx-statement-bottom">
                <span class="rdx-statement-line"></span>
                <span>RACEDAY / KEEP MOVING</span>
            </div>

        </div>

    </section>

    <!-- FINAL CALL TO ACTION -->
    <section class="rdx-final">

        <div class="rdx-shell">

            <div class="rdx-final-content">

                <span class="rdx-final-eyebrow">
                    YOUR NEXT CHALLENGE AWAITS
                </span>

                <h2>
                    The starting line
                    is calling.
                </h2>

                <p>
                    Every journey begins with
                    the decision to start.
                </p>

                <a asp-controller="@destinationController"
                   asp-action="@destinationAction"
                   class="rdx-final-button">

                    @primaryLabel
                    <span aria-hidden="true">↗</span>

                </a>

            </div>

            <div class="rdx-final-watermark"
                 aria-hidden="true">
                RD.
            </div>

        </div>

    </section>

</div>

<style>
    /* ==========================================
           RACEDAY HOMEPAGE V2
           ========================================== */

    .rdx-home {
        background: #F8F9FB;
        color: #111827;
        overflow: hidden;
    }

        .rdx-home *,
        .rdx-home *::before,
        .rdx-home *::after {
            box-sizing: border-box;
        }

    .rdx-shell {
        width: min(1180px, calc(100% - 48px));
        margin-inline: auto;
    }

    /* ==========================================
           CINEMATIC HERO
           ========================================== */

    .rdx-hero {
        position: relative;
        min-height: 760px;
        display: flex;
        isolation: isolate;
        overflow: hidden;
        background: #0C1424;
        color: #FFFFFF;
    }

    .rdx-hero-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 45%;
        animation: rdx-hero-scale 1.6s ease-out both;
    }

    .rdx-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient( 90deg, rgba(7,15,30,.88) 0%, rgba(7,15,30,.67) 34%, rgba(7,15,30,.22) 72%, rgba(7,15,30,.14) 100% ), linear-gradient( 0deg, rgba(7,15,30,.72), transparent 38% );
    }

    .rdx-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
        padding-top: 105px;
        padding-bottom: 55px;
    }

    .rdx-hero-content {
        max-width: 820px;
        animation: rdx-rise 1s cubic-bezier(.22,1,.36,1) both;
    }

    .rdx-eyebrow,
    .rdx-section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .17em;
    }

    .rdx-hero-eyebrow {
        color: rgba(255,255,255,.82);
    }

    .rdx-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #46C68B;
        box-shadow: 0 0 0 5px rgba(70,198,139,.13);
    }

    .rdx-hero-title {
        max-width: 850px;
        margin: 28px 0;
        font-size: clamp(64px, 8.5vw, 132px);
        font-weight: 780;
        line-height: .96;
        letter-spacing: -.075em;
        color: #FFFFFF;
        text-wrap: balance;
    }

        .rdx-hero-title span {
            display: block;
            color: rgba(255,255,255,.76);
        }

    .rdx-hero-description {
        max-width: 480px;
        color: rgba(255,255,255,.83);
        font-size: 17px;
        line-height: 1.8;
    }

    .rdx-hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-top: 34px;
    }

    .rdx-primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 36px;
        padding: 16px 25px;
        border-radius: 999px;
        background: #FFFFFF;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: transform .4s cubic-bezier(.22,1,.36,1), background .3s ease;
    }

        .rdx-primary-button:hover {
            transform: translateY(-3px);
            background: #E7F0FF;
            color: #111827;
        }

    .rdx-hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .rdx-hero-secondary:hover {
            color: #D5A73F;
        }

    .rdx-hero-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 95px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .15em;
        color: rgba(255,255,255,.78);
    }

    .rdx-hero-index {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .rdx-index-line {
        width: 45px;
        height: 1px;
        background: #D5A73F;
    }

    .rdx-hero-categories span {
        padding: 0 9px;
        color: #D5A73F;
    }

    .rdx-hero-outline {
        position: absolute;
        bottom: -90px;
        right: 18px;
        font-size: clamp(180px, 27vw, 430px);
        line-height: 1;
        font-weight: 800;
        letter-spacing: -.13em;
        color: rgba(255,255,255,.055);
        pointer-events: none;
    }

    /* ==========================================
           RACE STRIP
           ========================================== */

    .rdx-race-strip {
        background: #FFFFFF;
        border-bottom: 1px solid #E8EDF3;
    }

    .rdx-strip-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-block: 26px;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .16em;
        color: #526174;
    }

    .rdx-strip-symbol {
        color: #D5A73F;
        font-size: 21px;
    }

    /* ==========================================
           EDITORIAL INTRO
           ========================================== */

    .rdx-intro {
        padding: 135px 0;
        background: #FFFFFF;
    }

    .rdx-intro-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 100px;
        align-items: center;
    }

    .rdx-section-eyebrow {
        color: #64748B;
    }

    .rdx-section-heading {
        margin: 22px 0 0;
        font-size: clamp(42px, 5.5vw, 76px);
        font-weight: 750;
        line-height: 1.06;
        letter-spacing: -.065em;
        color: #111827;
    }

        .rdx-section-heading span {
            display: block;
            color: #94A3B8;
        }

    .rdx-intro-copy {
        padding-top: 45px;
    }

        .rdx-intro-copy p {
            margin-bottom: 23px;
            color: #64748B;
            font-size: 17px;
            line-height: 1.9;
        }

    .rdx-intro-detail {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 35px;
        color: #64748B;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .15em;
    }

    .rdx-intro-detail-line {
        width: 35px;
        height: 2px;
        background: #176BDA;
    }

    /* ==========================================
           IMAGE-LED FEATURES
           ========================================== */

    .rdx-journey {
        padding: 110px 0 130px;
        background: #F1F4F8;
    }

    .rdx-journey-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 50px;
        margin-bottom: 50px;
    }

        .rdx-journey-heading p {
            max-width: 300px;
            margin: 0 0 5px;
            color: #64748B;
            font-size: 15px;
            line-height: 1.8;
        }

    .rdx-feature-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 22px;
    }

    .rdx-feature {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 470px;
        padding: 32px;
        overflow: hidden;
        border-radius: 25px;
        isolation: isolate;
        background: #0C1424;
        color: #FFFFFF;
        transition: transform .55s cubic-bezier(.22,1,.36,1), box-shadow .55s ease;
    }

        .rdx-feature:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 65px rgba(15,23,42,.17);
        }

        .rdx-feature > img {
            position: absolute;
            inset: 0;
            z-index: -2;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .9s cubic-bezier(.22,1,.36,1);
        }

        .rdx-feature:hover > img {
            transform: scale(1.055);
        }

    .rdx-feature-shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient( 180deg, rgba(4,12,26,.42) 0%, rgba(4,12,26,.03) 35%, rgba(4,12,26,.88) 100% );
    }

    .rdx-feature-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .13em;
        color: rgba(255,255,255,.9);
    }

        .rdx-feature-top span:last-child {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.5);
            background: rgba(255,255,255,.1);
            font-size: 19px;
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
        }

    .rdx-feature-content {
        position: relative;
        z-index: 1;
        max-width: 470px;
    }

    .rdx-feature-kicker {
        display: block;
        margin-bottom: 14px;
        color: #E8C66E;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .15em;
    }

    .rdx-feature-content h3 {
        max-width: 440px;
        margin-bottom: 16px;
        font-size: clamp(30px, 3.5vw, 50px);
        font-weight: 730;
        line-height: 1.07;
        letter-spacing: -.055em;
        color: #FFFFFF;
    }

    .rdx-feature-content p {
        max-width: 340px;
        margin-bottom: 0;
        color: rgba(255,255,255,.83);
        font-size: 14px;
        line-height: 1.75;
    }

    .rdx-feature-discover {
        grid-column: span 7;
    }

    .rdx-feature-participate {
        grid-column: span 5;
    }

    .rdx-feature-achieve {
        grid-column: span 12;
        min-height: 390px;
    }

        .rdx-feature-achieve .rdx-feature-content {
            max-width: 600px;
        }

    /* ==========================================
           EDITORIAL STATEMENT
           ========================================== */

    .rdx-statement {
        padding: 135px 0;
        background: #FFFFFF;
    }

    .rdx-statement-inner {
        max-width: 1000px;
    }

    .rdx-statement h2 {
        margin: 30px 0 50px;
        font-size: clamp(46px, 6.5vw, 90px);
        font-weight: 750;
        line-height: 1.08;
        letter-spacing: -.07em;
        color: #111827;
        text-wrap: balance;
    }

        .rdx-statement h2 span {
            color: #8F9AAA;
        }

    .rdx-statement-bottom {
        display: flex;
        align-items: center;
        gap: 15px;
        color: #64748B;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .17em;
    }

    .rdx-statement-line {
        width: 60px;
        height: 2px;
        background: #D5A73F;
    }

    /* ==========================================
           FINAL SECTION
           ========================================== */

    .rdx-final {
        position: relative;
        padding: 125px 0;
        overflow: hidden;
        background: #0C1424;
        color: #FFFFFF;
    }

    .rdx-final-content {
        position: relative;
        z-index: 1;
        max-width: 820px;
    }

    .rdx-final-eyebrow {
        color: #9BAECB;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .17em;
    }

    .rdx-final h2 {
        margin: 25px 0;
        color: #FFFFFF;
        font-size: clamp(48px, 6vw, 82px);
        font-weight: 750;
        line-height: 1.06;
        letter-spacing: -.065em;
    }

    .rdx-final p {
        margin-bottom: 30px;
        color: #AAB7CA;
        font-size: 17px;
        line-height: 1.75;
    }

    .rdx-final-button {
        display: inline-flex;
        align-items: center;
        gap: 35px;
        padding: 15px 25px;
        background: #FFFFFF;
        border-radius: 999px;
        color: #111827;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: background .3s ease, transform .35s ease;
    }

        .rdx-final-button:hover {
            background: #E7F0FF;
            color: #111827;
            transform: translateY(-3px);
        }

    .rdx-final-watermark {
        position: absolute;
        right: -30px;
        bottom: -110px;
        font-size: clamp(190px, 29vw, 450px);
        font-weight: 800;
        letter-spacing: -.13em;
        line-height: 1;
        color: rgba(255,255,255,.045);
        pointer-events: none;
    }

    /* ==========================================
           ANIMATIONS
           ========================================== */

    @@keyframes rdx-rise {
        from {
            opacity: 0;
            transform: translateY(28px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes rdx-hero-scale {
        from {
            opacity: .6;
            transform: scale(1.05);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ==========================================
           RESPONSIVE
           ========================================== */

    @@media (max-width: 991px) {
        .rdx-hero {
            min-height: 690px;
        }

        .rdx-hero-title {
            font-size: clamp(64px, 9vw, 100px);
        }

        .rdx-intro-grid {
            gap: 45px;
        }

        .rdx-journey-heading {
            align-items: start;
            flex-direction: column;
            gap: 20px;
        }

        .rdx-feature-discover,
        .rdx-feature-participate {
            grid-column: span 6;
        }

        .rdx-feature {
            min-height: 430px;
        }
    }

    @@media (max-width: 700px) {
        .rdx-shell {
            width: calc(100% - 34px);
        }

        .rdx-hero {
            min-height: 670px;
        }

        .rdx-hero-inner {
            padding-top: 80px;
            padding-bottom: 32px;
        }

        .rdx-hero-image {
            object-position: 58% center;
        }

        .rdx-hero-title {
            font-size: clamp(55px, 12vw, 80px);
        }

        .rdx-hero-description {
            font-size: 15px;
        }

        .rdx-hero-actions {
            gap: 22px;
        }

        .rdx-hero-bottom {
            margin-top: 75px;
            flex-wrap: wrap;
            font-size: 9px;
        }

        .rdx-strip-inner {
            flex-wrap: wrap;
            justify-content: center;
            text-align: center;
            gap: 12px;
            padding-block: 20px;
            font-size: 9px;
        }

        .rdx-intro,
        .rdx-statement {
            padding: 80px 0;
        }

        .rdx-intro-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .rdx-intro-copy {
            padding-top: 0;
        }

            .rdx-intro-copy p {
                font-size: 15px;
            }

        .rdx-journey {
            padding: 80px 0;
        }

        .rdx-feature-discover,
        .rdx-feature-participate,
        .rdx-feature-achieve {
            grid-column: span 12;
        }

        .rdx-feature {
            min-height: 400px;
            padding: 24px;
            border-radius: 20px;
        }

        .rdx-feature-content h3 {
            font-size: 36px;
        }

